NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/rkabh?retryWrites=true&w=majority

JWT_SECRET=replace-with-at-least-32-random-characters
